    {
      "type": "text", "id": "col1_h",
      "x": 60, "y": 712, "width": 460, "height": 26,
      "text": "1  ·  AVANT — la boîte noire", "originalText": "1  ·  AVANT — la boîte noire",
      "fontSize": 19, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top",
